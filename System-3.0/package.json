{
  "name": "fine-form-3-0",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "configure": "node scripts/configure.mjs",
    "deploy": "node scripts/deploy.mjs",
    "backup": "wrangler d1 export DB --remote --output=backup.sql",
    "security:setup": "node scripts/security-setup.mjs",
    "check": "npm test && npm run build && node scripts/verify-build-assets.mjs && wrangler deploy --dry-run --outdir .test-build",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "preview:configure": "node scripts/preview-configure.mjs",
    "preview": "node scripts/preview.mjs",
    "reuse": "node scripts/reuse-existing.mjs",
    "notifications:setup": "node scripts/notifications-setup.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "motion": "12.23.24",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "30.1.2",
    "miniflare": "4.20260730.0",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "undici": "7.29.1",
      "sharp": "0.35.5"
    }
  }
}
